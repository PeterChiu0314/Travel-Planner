{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/timeline-phase-4-0-to-4-2": true
    }
  },
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/index.html"
    }
  ]
}
